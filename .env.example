# Copy this file to `.env` and fill in real values.

# MongoDB Atlas connection (SRV). Replace placeholders with your cluster/user/password.
# Example: mongodb+srv://dbuser:dbpass@cluster0.ab1cd.mongodb.net/skillrise?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<DB_USER>:<DB_PASS>@<CLUSTER_HOST>.mongodb.net/skillrise?retryWrites=true&w=majority"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: if SRV lookups are blocked in your environment, use the standard connection string
# (Atlas > Connect > Drivers > Copy a connection string without SRV) and set it here instead.
# DATABASE_URL="mongodb://<user>:<pass>@host1:port,host2:port/skillrise?authSource=admin&replicaSet=..."
